# Deployment overlay for the internal BI instance on host `lwutil`.
#
# The instance runs the metadata DB on PostgreSQL and the analytics DB on
# ClickHouse (via the superset_clickhouse_tunnel container), so the image
# needs extras that no standard Dockerfile target installs:
#
#   .[postgres]    psycopg2 -- already installed by the `dev` target
#   .[clickhouse]  clickhouse-connect -- REQUIRED, the analytics DB
#                  dialect (clickhousedb); without it every chart fails
#                  with "Can't load plugin: sqlalchemy.dialects:clickhousedb"
#   .[fastmcp]     fastmcp>=3.4.7 -- the runtime MCP server (the mcp extras
#                  pinned in requirements are dev-only versions)
#   numexpr        present in requirements/base.txt but NOT in
#                  requirements/development.txt (independently compiled),
#                  so the dev target image lacks it
#
# Build (from the repository root, after building the base dev image):
#   docker build -t <tag> --build-arg BASE=<base-dev-image-tag> \
#       -f docker/Dockerfile.deploy-lwutil .
#
# Deploy: update `x-superset-image` in docker-compose-image-tag.yml on
# lwutil (/var/lib/superset/superset_source) and run
# `docker compose -f docker-compose-image-tag.yml up -d`.

ARG BASE=superset-local:dev
FROM ${BASE}
USER root
RUN uv pip install --python /app/.venv/bin/python \
    ".[clickhouse,fastmcp,postgres]" "numexpr==$(grep -oP 'numexpr==\K[0-9.]+' requirements/base.txt)"
USER superset
