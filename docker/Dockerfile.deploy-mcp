# Verify the existing 6.1.0 image ID before supplying its local snapshot tag.
ARG BASE_IMAGE=superset-local:6.1.0-mcp-2a711cf17
FROM ${BASE_IMAGE}
USER root
WORKDIR /app
COPY superset/ /app/superset/
COPY superset-core/ /app/superset-core/
COPY pyproject.toml setup.py MANIFEST.in /app/
ARG VCS_REF
LABEL org.opencontainers.image.source="https://github.com/hao3039032/superset" \
      org.opencontainers.image.revision=${VCS_REF} \
      org.opencontainers.image.ref.name="deploy/6.1"
USER superset
